+            ascent: font.ascent as f64,
+            descent: font.descent as f64,
+            cap_height: font.ascent as f64,
+            x_height: font.ascent as f64 * 0.5,
+            shaper: None,
+            coords: Vec::new(),
+            location: Location::default(),
+            instance: None,
+            bytes: FontBytes::Owned(font.data.clone()),
+            index: 0,
+            bmp: Default::default(),
+            legacy: None,
+            color: Default::default(),
+            line_split: font.ascent as f64 / (font.ascent + font.descent) as f64,
+            underline: (1., 1.),
+            strikeout: (font.ascent as f64 * 0.4, 1.),
+            bitmap: Some(font),
+        }
+    }
+    pub fn bitmap_path(&self, gid: u32) -> Option<BezPath> {
+        let font = self.bitmap.as_ref()?;
+        let mut path = BezPath::new();
+        for [x, y, w, h] in font.rectangles(gid) {
+            path.move_to((x, y));
+            path.line_to((x + w, y));
+            path.line_to((x + w, y + h));
+            path.line_to((x, y + h));
+            path.close_path();
+        }
+        Some(path)
+    }
+}
